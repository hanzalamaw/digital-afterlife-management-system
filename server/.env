DB_HOST=localhost
DB_PORT=3306
DB_NAME=dams
DB_USER=root
DB_PASS=
JWT_SECRET=dams_super_secret_jwt_key_make_it_long_and_random
JWT_EXPIRY=3600
SOCKET_PORT=9000
APP_NAME=DAMS

# ---------------------------------------------------------------------------
# Vault encryption
# ---------------------------------------------------------------------------
# Used to AES-256-CBC encrypt every vault value written from the New Asset
# page. Change this to a long random string in production. Do NOT change it
# after data has been encrypted (existing vault entries would become
# undecryptable).
VAULT_ENCRYPTION_KEY=please-change-me-to-a-long-random-32-char-secret

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# DAMS sends transactional emails (reminders, suspect-death notices,
# confirmed-death notices). Configure your SMTP server below.
#
# Gmail example (recommended for testing):
#   1) Enable 2-Step Verification on your Google account.
#   2) Create an "App password" at https://myaccount.google.com/apppasswords
#   3) Use the values below.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=tls
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   MAIL_FROM=your.address@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=rgocerp@gmail.com
SMTP_PASS=jvldzrxxnpiinszj
MAIL_FROM=rgocerp@gmail.com
MAIL_FROM_NAME=DAMS
MAIL_DRY_RUN=0

#
# Mailtrap (sandbox — emails never reach real inboxes, great for dev):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=tls
#   SMTP_USER=<your-mailtrap-user>
#   SMTP_PASS=<your-mailtrap-pass>
#
# Set MAIL_DRY_RUN=1 to skip SMTP entirely and only write to
# server/logs/mail.log + the notification_log table. Useful before you have
# real credentials.
# MAIL_DRY_RUN=1

# ---------------------------------------------------------------------------
# Auto-running cron
# ---------------------------------------------------------------------------
# Every time any API request hits the server, index.php silently runs the
# inactivity sweep IF this many seconds have passed since the last run.
# Set to 0 to disable the auto-trigger entirely.
AUTO_SWEEP_INTERVAL_SECONDS=900

# Optional: if you ever want to invoke /api/cron/inactivity-sweep manually
# from outside (e.g. Task Scheduler), this token gates the public endpoint.
CRON_SECRET=change-this-to-a-long-random-secret
