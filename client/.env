## Frontend environment variables (Vite)
#
# Point this at wherever `server/index.php` is reachable from the browser.
#
# Examples:
# - If you run: `php -S localhost:8000 server/index.php`
#   VITE_API_BASE_URL=http://localhost:8000
#
# - If you use XAMPP/Apache and your project folder is:
#   http://localhost/digital-afterlife-management-system/
#   then the PHP API entry is typically:
#   http://localhost/digital-afterlife-management-system/server
#   VITE_API_BASE_URL=http://localhost/digital-afterlife-management-system/server
#
VITE_API_BASE_URL=http://localhost:8000/server/index.php

